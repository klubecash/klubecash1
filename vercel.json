{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "KlubeCashNew",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "PHP_BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "crons": [
    {
      "path": "/api/internal/notifications",
      "schedule": "15 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": { "service": "frontend" } },
    { "source": "/login", "destination": { "service": "frontend" } },
    { "source": "/registro", "destination": { "service": "frontend" } },
    { "source": "/recuperar-senha", "destination": { "service": "frontend" } },
    { "source": "/_next/(.*)", "destination": { "service": "frontend" } },
    { "source": "/api/admin/(.*)", "destination": { "service": "frontend" } },
    { "source": "/api/store/(.*)", "destination": { "service": "frontend" } },
    { "source": "/api/auth/(.*)", "destination": { "service": "frontend" } },
    { "source": "/api/whatsapp/auth/(.*)", "destination": { "service": "frontend" } },
    { "source": "/whatsapp/autenticar", "destination": { "service": "frontend" } },
    { "source": "/admin", "destination": { "service": "frontend" } },
    { "source": "/admin/(.*)", "destination": { "service": "frontend" } },
    { "source": "/store", "destination": { "service": "frontend" } },
    { "source": "/store/(.*)", "destination": { "service": "frontend" } },
    { "source": "/(.*)", "destination": { "service": "backend" } }
  ]
}
