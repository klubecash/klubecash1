# Arquivo de referência: cadastre estes valores no ambiente da hospedagem.
# Nunca coloque senhas neste arquivo versionado.

# URL pública usada nos links enviados por e-mail
SITE_URL=https://www.klubecash.com

# Sessões persistentes para o runtime serverless
SESSION_DRIVER=database
SESSION_NAME=KLCSESSID

# Resend SMTP: porta 465 com SSL/TLS implícito
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notificacoes@klubecash.com
SMTP_FROM_NAME="Klube Cash"
SMTP_ENCRYPTION=smtps

# Integração local do Next.js com o backend PHP
PHP_BACKEND_URL=http://127.0.0.1:8000
# next: usa a nova área lojista; legacy: devolve todas as rotas /store ao PHP
STORE_UI_MODE=next
# Rollback seletivo, separado por vírgulas. Ex.: transacoes,perfil
STORE_LEGACY_ROUTES=

# WhatsApp via WAHA (somente backend)
WAHA_BASE_URL=https://waha-klubecash.82.112.245.20.sslip.io
WAHA_API_KEY=SUA_CHAVE_DA_API_WAHA
WAHA_SESSION=klubecash
WAHA_WEBHOOK_HMAC_KEY=UMA_CHAVE_SECRETA_FORTE

# Assinatura Bearer enviada automaticamente pelo Vercel Cron
CRON_SECRET=UMA_CHAVE_ALEATORIA_DIFERENTE
